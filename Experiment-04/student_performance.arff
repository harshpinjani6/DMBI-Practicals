@relation student_performance

@attribute Attendance {High,Medium,Low}
@attribute Study_Hours {High,Medium,Low}
@attribute Internal_Marks {High,Medium,Low}
@attribute Result {Pass,Fail}

@data
High,High,High,Pass
High,Medium,High,Pass
Medium,High,High,Pass
Low,Low,Low,Fail
Low,Medium,Low,Fail
Medium,Low,Low,Fail
High,Low,Medium,Pass
Low,High,Medium,Pass
Medium,Medium,Medium,Pass
Low,Low,Medium,Fail
Medium,High,Medium,Pass
High,Medium,Medium,Pass
